<rml>
<head>
    <title>Skor Tablosu</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="scoreboard.rcss"/>
</head>
<body>
    <div id="board">
        <div id="header">
            <div id="title">SKOR TABLOSU</div>
            <div id="summary"></div>
        </div>

        <div class="section players">
            <div class="section-head">
                <div class="section-name">OYUNCULAR</div>
                <div class="section-count" id="players-count"></div>
            </div>
            <div class="columns">
                <div class="col rank">#</div>
                <div class="col name">OYUNCU</div>
                <div class="col health">CAN</div>
                <div class="col id">ID</div>
            </div>
            <div id="players-rows"></div>
        </div>

        <div class="section bots">
            <div class="section-head">
                <div class="section-name">BOTLAR</div>
                <div class="section-count" id="bots-count"></div>
            </div>
            <div class="columns">
                <div class="col rank">#</div>
                <div class="col name">BOT</div>
                <div class="col health">CAN</div>
                <div class="col id">ID</div>
            </div>
            <div id="bots-rows"></div>
        </div>
    </div>
</body>
</rml>
