<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<body>
    <div id="crosshair">
        <div class="tick up"></div>
        <div class="tick down"></div>
        <div class="tick left"></div>
        <div class="tick right"></div>
    </div>

    <div id="health-panel">
        <div id="health-label">HEALTH</div>
        <div id="health-value">100</div>
        <div id="health-track"><div id="health-fill"></div></div>
    </div>
</body>
</rml>
